# SITE_ADDRESS is the public host name, such as 52-65-56-135.sslip.io; Caddy
# gets and renews its HTTPS certificate on its own.
# The API answers /api/* and /health. Every other path is the web client, a
# separate compose project (appointment_system_frontend/deploy) reached as web:80
# over the shared appointment-edge network; while it is down those paths get 502.
{$SITE_ADDRESS} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:80
	}
}
