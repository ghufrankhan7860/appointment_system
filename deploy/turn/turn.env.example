# Copy to deploy/turn/.env on the server (git-ignored). Never commit real values.
# TURN_SECRET is the same value as TURN_SECRET in envs/.env.staging and envs/.env.production, at least 32 characters.
TURN_SECRET=
# The Elastic IP and the instance's private IP: public/private, e.g. 13.55.81.62/172.31.5.20.
TURN_EXTERNAL_IP=
