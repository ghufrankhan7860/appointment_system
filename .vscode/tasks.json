{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start PostgreSQL",
            "type": "shell",
            "command": "docker compose -f deploy/compose.yaml up -d --wait",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Stop PostgreSQL",
            "type": "shell",
            "command": "docker compose -f deploy/compose.yaml down",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
