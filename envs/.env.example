# Application
APP_NAME=appointment-system
HTTP_ADDRESS=:8080

# PostgreSQL local-development values. Use deployment secrets outside local development.
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=appointment
DB_PASSWORD=appointment-local
DB_NAME=appointment_system
# disable for the local container; require (or verify-full) for a hosted database such as Neon.
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Authentication. Replace JWT_SECRET outside local development.
JWT_SECRET=appointment-local-jwt-secret-change-me
JWT_ISSUER=appointment-system
# Clinic timezone. Doctor availability times (HH:MM) are local to it.
APP_TIMEZONE=Asia/Kolkata
# Payment gateway. "none" moves no money, for local development only; it is refused when APP_ENV is production.
PAYMENT_PROVIDER=none
# Only for PAYMENT_PROVIDER=razorpay: the API key id and secret (Dashboard > Account & Settings > API Keys) and the
# secret you chose for the webhook (at least 32 characters). Outside production the key id must start with rzp_test_,
# in production with rzp_live_. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Uploaded medical files. "local" keeps them under STORAGE_LOCAL_DIR; mount a persistent volume there outside development.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=var/storage
# Logging. Production: json at info to stdout, collected by the container runtime. Locally text is easier to read.
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_SOURCE=true
# Set LOG_FILE to a path to also append every log line to that file (folder created if missing); empty logs to the terminal only.
LOG_FILE=
# Reverse proxies (IPs or CIDRs, comma-separated) whose X-Forwarded-For gives the client IP; empty trusts none.
# Behind Caddy in Docker, set the subnet of the network Caddy reaches the api on.
TRUSTED_PROXIES=
